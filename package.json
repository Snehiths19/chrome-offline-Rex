{
  "name": "chrome-offline-rex",
  "version": "1.0.0",
  "private": true,
  "description": "A clone of the Chrome offline dinosaur game, built with vanilla JavaScript and HTML5 Canvas.",
  "scripts": {
    "test": "node tests/game.test.js",
    "lint": "eslint script.js tests/game.test.js",
    "format": "prettier --write script.js tests/game.test.js style.css index.html",
    "format:check": "prettier --check script.js tests/game.test.js style.css index.html",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "prettier": "^3.3.3"
  }
}
